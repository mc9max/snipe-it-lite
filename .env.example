# ------------------------------
# Snipe-IT Lite (SQLite, Hobby-tier)
# ------------------------------

# Laravel app key (base64:...). Auto-generated per deployment — NEVER change after first boot.
APP_KEY=<auto-generated-per-deployment>

# Public URL — auto-set by Railway
APP_URL=${{RAILWAY_PUBLIC_DOMAIN}}

# Database: SQLite on the persistent volume
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/snipeit/database.sqlite

# Memory-constrained worker settings (Hobby plan ~512MB)
PHP_FPM_PM_MAX_CHILDREN=2
PHP_MEMORY_LIMIT=256M

# App basics
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=en-US

# Trusted proxy — Railway's edge terminates TLS.
# "**" trusts Railway as the only proxy. Required for the pre-flight URL check.
APP_TRUSTED_PROXIES=**

# Trust Railway's X-Forwarded-* headers so Laravel detects HTTPS correctly.
APP_TRUSTED_HEADERS=HEADER_X_FORWARDED_FOR,HEADER_X_FORWARDED_HOST,HEADER_X_FORWARDED_PORT,HEADER_X_FORWARDED_PROTO,HEADER_X_FORWARDED_PREFIX

# Session/mail (optional overrides)
MAIL_MAILER=log
SESSION_DRIVER=file

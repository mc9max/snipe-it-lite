{
  "$schema": "https://railway.app/schema.json",
  "name": "Snipe-IT Lite",
  "description": "Self-hosted IT asset management with SQLite storage - single container, Hobby-tier friendly.",
  "placeholderDefinitions": [],
  "services": {
    "snipe-it": {
      "source": {
        "image": "ghcr.io/inapp-mobile/snipe-it-lite:latest"
      },
      "variables": {
        "APP_KEY": "${{secret(32)}}",
        "APP_URL": "${{RAILWAY_PUBLIC_DOMAIN}}",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": "/var/lib/snipeit/database.sqlite",
        "PHP_FPM_PM_MAX_CHILDREN": "2",
        "PHP_MEMORY_LIMIT": "256M",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_TRUSTED_PROXIES": "10.0.0.0/8",
        "SESSION_DRIVER": "file",
        "MAIL_MAILER": "log"
      },
      "volumes": [
        {
          "name": "snipeit-data",
          "mountPath": "/var/lib/snipeit"
        }
      ]
    }
  }
}
